PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800
STEAM_WEB_API_KEY=

# Database
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_NAME=saas
DB_SSL=false

# Best flips sources
CSFLOAT_API_KEY=
BUFFMARKET_COOKIE=
BEST_FLIPS_ENABLE_SKINPORT_BUY=1
BEST_FLIPS_ENABLE_CSFLOAT_BUY=1
BEST_FLIPS_ENABLE_BUFFMARKET_BUY=0

# Best flips tuning
BEST_FLIPS_LIMIT=50
BEST_FLIPS_MAX_UNIQUE=120
BEST_FLIPS_CSFLOAT_PAGES=5
BEST_FLIPS_CSFLOAT_SCAN_LIMIT=50
BEST_FLIPS_CSFLOAT_PER_ITEM_MAX=20
BEST_FLIPS_BUFFMARKET_PER_ITEM_MAX=5
BEST_FLIPS_MIN_SALES_7D=0
BEST_FLIPS_ALLOW_SAME_MARKET=0
BEST_FLIPS_DEBUG=0

# Marketplace fees
SKINPORT_FEE_STANDARD=0.08
SKINPORT_FEE_HIGH_TIER=0.06
SKINPORT_HIGH_TIER_THRESHOLD_USD=0
BUFFMARKET_FEE_RATE=0.025
